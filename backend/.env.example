# IRIS FastAPI Backend Environment Configuration

# OpenRouter API Key (Get your key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini API Configuration (Get your key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_GEMINI_3_8_FLASH=google/gemini-3.8-flash

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# OpenRouter Primary & Supported Models (Separate Variables)
OPENROUTER_PRIMARY_MODEL=google/gemini-3.8-flash

MODEL_GEMMA_4_31B=google/gemma-4-31b-it:free
MODEL_GEMMA_4_26B=google/gemma-4-26b-a4b-it:free
MODEL_GLM_5_2=z-ai/glm-5.2:free
MODEL_MINIMAX_M3=minimax/minimax-m3:free
MODEL_INKLING=thinkingmachines/inkling:free
MODEL_INKLING_SMALL=thinkingmachines/inkling-small:free
MODEL_LFM_2_5=liquid/lfm-2.5-2.6b:free
MODEL_LING_3_0=inclusionai/ling-3.0-flash-fin:free
MODEL_DOTS_3=dots-studio/dots-3-note-preview:free
MODEL_LAGUNA_S_2_1=poolside/laguna-s-2.1:free
MODEL_LLAMA_3_3_70B=meta-llama/llama-3.3-70b-instruct:free
MODEL_GEMINI_2_0_FLASH=google/gemini-2.0-flash-lite-preview-02-05:free
MODEL_QWEN_2_5_72B=qwen/qwen-2.5-72b-instruct:free
MODEL_DEEPSEEK_R1=deepseek/deepseek-r1:free

# Server Settings
# For Render deployment: HOST should be 0.0.0.0 (Render automatically overrides PORT)
HOST=0.0.0.0
PORT=8000

# Frontend URL (Used for CORS and OpenRouter Referer)
# Local: http://localhost:5173 | Production Vercel: https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated)
# Note: https://*.vercel.app is automatically supported by regex in main.py
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# RAG & Session Memory Settings (Lightweight in-memory mode: < 2MB RAM)
MAX_RAG_CONTEXT_TURNS=4

# Optional: Google Maps Platform API key (for Google Places Nearby Search)
# If left empty, IRIS uses live OpenStreetMap Overpass API and Google Maps navigation deep links
GOOGLE_MAPS_API_KEY=

