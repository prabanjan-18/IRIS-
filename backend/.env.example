# IRIS FastAPI Backend Environment Configuration

# OpenRouter API Key (Get your key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Primary & Supported Models (Separate Variables)
OPENROUTER_PRIMARY_MODEL=google/gemma-4-31b-it:free

MODEL_GEMMA_4_31B=google/gemma-4-31b-it:free
MODEL_GEMMA_4_26B=google/gemma-4-26b-a4b-it:free
MODEL_GLM_5_2=z-ai/glm-5.2:free
MODEL_MINIMAX_M3=minimax/minimax-m3:free
MODEL_INKLING=thinkingmachines/inkling:free
MODEL_INKLING_SMALL=thinkingmachines/inkling-small:free
MODEL_LFM_2_5=liquid/lfm-2.5-2.6b:free
MODEL_LING_3_0=inclusionai/ling-3.0-flash-fin:free
MODEL_DOTS_3=dots-studio/dots-3-note-preview:free
MODEL_LAGUNA_S_2_1=poolside/laguna-s-2.1:free
MODEL_LLAMA_3_3_70B=meta-llama/llama-3.3-70b-instruct:free
MODEL_GEMINI_2_0_FLASH=google/gemini-2.0-flash-lite-preview-02-05:free
MODEL_QWEN_2_5_72B=qwen/qwen-2.5-72b-instruct:free
MODEL_DEEPSEEK_R1=deepseek/deepseek-r1:free

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# RAG & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DB_DIR=./chroma_db
MAX_RAG_CONTEXT_TURNS=4
