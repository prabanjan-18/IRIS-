# ==============================================================================
# IRIS Healthcare AI - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment variables and secrets (Never commit sensitive API keys)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!*.env.example
!backend/.env.example
!frontend/.env.example
!frontend/.env.production

# ------------------------------------------------------------------------------
# Python & Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments & embedded Python binaries
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
py_embed/
backend/py_embed/
*.zip
backend/python.zip

# Vector Database, ChromaDB, & ML model caches
chroma_db/
backend/chroma_db/
*.db
*.sqlite3
*.parquet
.cache/
huggingface/
sentence_transformers/
torch_cache/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Frontend (React / Vite)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.vite/
frontend/.vite/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
