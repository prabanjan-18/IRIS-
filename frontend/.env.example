# IRIS Frontend Environment Configuration

# Backend API Base URL
# Local Development:
VITE_BACKEND_URL=http://127.0.0.1:8000

# Production Deployment (Vercel):
# In your Vercel project dashboard, set VITE_BACKEND_URL to your Render web service URL:
# VITE_BACKEND_URL=https://your-iris-backend.onrender.com

# Optional: Google Maps Platform API key (for Google Places Nearby Search)
# If not provided, IRIS automatically uses OpenStreetMap live healthcare data and direct Google Maps links
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

